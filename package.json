{
	"name": "work-league",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:node": "WORK_LEAGUE_ADAPTER=node vite build",
		"start": "node build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.0.16",
		"vitest": "^4.1.12",
		"wrangler": "^4.125.0"
	},
	"description": "Self-hosted office league: pool, ping pong, darts and your own games, with ELO ratings and an office championship.",
	"dependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@material/material-color-utilities": "^0.4.0",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"valibot": "^1.5.0"
	},
	"license": "MIT",
	"author": "TheTrueFerret (https://github.com/TheTrueFerret)",
	"repository": {
		"type": "git",
		"url": "https://github.com/TheTrueFerret/work-league.git"
	},
	"engines": {
		"node": ">=22.18"
	}
}
