# Work League configuration. Copy to .env for local development.
# Everything else (name, logo, colours, games, passphrase) is set in the app at /admin.

# Where the data lives: a SQLite file, created and migrated on first use.
# (On Cloudflare Workers this is ignored; the app uses the D1 binding in wrangler.jsonc.)
DATABASE_URL=file:./.data/league.db
# A hosted libSQL database (Turso) works too: libsql://…?authToken=…

# Unlocks /admin. Admin features stay off until this is set.
ADMIN_PASSWORD=change-me

# Optional. Signs session cookies; a random one is stored in the database if unset.
# SESSION_SECRET=

# Node / Docker only: the public URL people open, needed for form submissions.
# ORIGIN=https://league.example.com
