# Supabase → Project Settings → Database → Connection string → URI.
# Swap [YOUR-PASSWORD] for your database password.
#
# Used by the migration and seed scripts, and by `npm run dev`.
# The deployed Worker reads its own copy — see `wrangler secret put DATABASE_URL`.
DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
