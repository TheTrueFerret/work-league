# Supabase → Connect → Transaction pooler. Copy the URI and delete the
# ":[YOUR-PASSWORD]" part — the password goes in DATABASE_PASSWORD below.
# Nothing here is secret, so this half can live in wrangler.jsonc too.
DATABASE_URL=postgresql://postgres.abcdefghijklm@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Your Supabase database password. This is the only real secret.
# Quote it — an unquoted "#" starts a comment and would silently truncate it.
DATABASE_PASSWORD="your-database-password"
