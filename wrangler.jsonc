{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "work-league",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-20",

	// postgres.js needs node:net, node:tls and Buffer to reach the database.
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	"observability": {
		"enabled": true
	},

	// Secrets are set outside this file:
	//   npx wrangler secret put DATABASE_URL     (a postgres:// URL; PGlite cannot run on Workers)
	//   npx wrangler secret put ADMIN_PASSWORD
	// Wrangler deletes dashboard variables on deploy unless told to keep them.
	"keep_vars": true
}
