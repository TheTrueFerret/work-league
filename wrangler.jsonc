{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pottr",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-20",

	// postgres.js needs node:net, node:tls and Buffer to reach Supabase.
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	"observability": {
		"enabled": true
	},

	// Wrangler treats this file as the source of truth and deletes dashboard
	// variables on deploy unless told otherwise. DATABASE_URL is set outside
	// this file, so keep it.
	"keep_vars": true
}
